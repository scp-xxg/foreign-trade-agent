FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

# Debian Bookworm provides Python 3.11 and SQLite 3.40+, both meeting the
# project's minimum versions. Git and build tools are included for setup.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-venv \
        python3.11-dev \
        sqlite3 \
        libsqlite3-dev \
        git \
        build-essential \
        cargo \
        rustc \
        ca-certificates \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && python3.11 -c "import sqlite3, sys; assert sys.version_info >= (3, 11); assert sqlite3.sqlite_version_info >= (3, 38); print(sys.version); print('SQLite', sqlite3.sqlite_version)" \
    && node --version \
    && git --version \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["bash"]
