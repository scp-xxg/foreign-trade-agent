# A single isolated local image for the two trade workflows.
FROM node:22-trixie-slim@sha256:2117f713a417f3aff682ac8f5bc2ebbdf1beed51f36e67ab1e0fd3866b6d2d8f AS node
FROM python:3.12-slim-trixie@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS dependencies
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:${PATH}" NODE_OPTIONS="--max-old-space-size=6144"
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates build-essential cargo rustc bubblewrap fonts-noto-cjk fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-sailagent.lock ./
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/venv \
    && python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt -c requirements-sailagent.lock
COPY packages/ packages/
COPY src/frontend/package.json src/frontend/package-lock.json src/frontend/
RUN npm --prefix src/frontend ci --no-audit --no-fund
COPY . .
RUN ln -s /opt/venv /app/.venv \
    && python -m pip install --no-deps -e . \
    && VITE_EDITION=ce VITE_DEFAULT_LANGUAGE=zh-CN npm --prefix src/frontend run build
VOLUME ["/data"]
EXPOSE 3002
HEALTHCHECK --interval=20s --timeout=5s --start-period=120s --retries=5 \
    CMD python -c "import json,urllib.request; r=json.load(urllib.request.urlopen('http://127.0.0.1:3002/ready',timeout=4)); assert r['ready']"
CMD ["python", "-m", "foreign_trade.launch", "--app-home", "/data", "--port", "3002"]
